#!/bin/bash
# Called by scdaemon on YubiKey state changes.
# Arguments: scd-event --reader-port <port> --old-code <code> --new-code <code> --status <status>

PATH=$PATH:/usr/local/MacGPG2/bin

reader_port=""
old_code="0x0000"
new_code="0x0000"
status=""

while [ $# -gt 0 ]; do
    case "$1" in
        --reader-port)  reader_port="$2"  ; shift 2 ;;
        --old-code)     old_code="$2"     ; shift 2 ;;
        --new-code)     new_code="$2"     ; shift 2 ;;
        --status)       status="$2"       ; shift 2 ;;
        *)              shift ;;
    esac
done

case $status in
    NOCARD)
        echo RELOADAGENT | gpg-connect-agent
        # Start macOS Screensaver
        open /System/Library/CoreServices/ScreenSaverEngine.app
        # Full macOS logout (uncomment to enable)
        # "/System/Library/CoreServices/Menu Extras/User.menu/Contents/Resources/CGSession" -suspend
        ;;
    PRESENT)
        echo UPDATESTARTUPTTY | gpg-connect-agent
        ;;
    *)
        exit 0
        ;;
esac
